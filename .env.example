# 재하봇 비밀 값. 쓰는 법:
#   cp .env.example .env       # .env 는 git·Docker 이미지에 들어가지 않는다(.gitignore, .dockerignore)
#   그리고 아래 값을 채운다. 앱이 app/config.py:load_env 로 읽는다(재시작만 하면 된다).
# 실제 키는 채팅·이슈·커밋에 붙이지 말 것.

# ── 필수 (전면 API 경로) ─────────────────────────────────────────────
# pipeline: realtime 이면 없을 때 기동에서 멈춘다(app/main_realtime.py:check_startup).
# 로컬 경로에서도 llm.backend: openai 이면 쓴다 — 로컬 경로는 키가 없으면 경고 없이
# 로컬 EXAONE 으로 내려가니, 켠 뒤 로그의 '폴백' 경고를 확인할 것.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 선택: 노래 틀기(youtube.enabled: true 일 때만) ─────────────────────
# YouTube Data API v3 키. 없으면 검색을 못 해 assets/songs 의 로컬 음원만 튼다.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_DATA_KEY=

# ── 선택: 비교 평가 도구 전용(tools/eval_llm.py). 봇 실행에는 필요 없다 ──
# 네이버 클로바 스튜디오 HyperCLOVA X — llm.api_model 을 HCX 로 둘 때도 쓴다.
CLOVA_STUDIO_KEY=
# Google AI Studio. ⚠️ Gemini 약관은 18세 미만 대상 앱에 쓰는 것을 금지한다 — 평가 전용.
#    무료 티어는 입력이 학습·사람 검수에 쓰이므로 실제 아이 녹음은 보내지 말 것.
GEMINI_API_KEY=
