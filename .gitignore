.claude
__pycache__/
*.pyc
.venv/
venv/
.env
# 기계별 설정 덮어쓰기(노트북 cpu / 젯슨 cuda 등). 예시는 configs/local.example.yaml
configs/local.yaml
# 모델 가중치 (용량 큼 — 별도 배포)
models/*
!models/.gitkeep
*.gguf
*.pt
*.onnx
# 동요·효과음 음원 (용량 — 목록/별칭은 configs/audio_assets.yaml 에 있고 git 에 들어간다)
assets/*
!assets/README.md
# 런타임 산출물
logs/*
!logs/.gitkeep
*.wav
*.mp4
# 원본 가이드(개인자료)
가이드 라인.pdf

# SDD 작업 산출물(원장·브리핑·리뷰패키지)
.superpowers/

# 호출어 학습용 합성 데이터(tools/gen_wake_supertonic.py 산출).
# wav 수만 개·수백 MB 라 저장소에 들어가면 안 된다. 재현은 도구 + manifest.jsonl 로 한다.
output/

# 턴 종료 판정 채점의 **원자료**(tools/eval_turn_detect.py --json).
# 발화 153개 x 판정 3,060회를 그대로 찍어 파일 하나가 2만 줄이 넘는다.
# 2026-08-24 에 이것만으로 변경분이 47,171줄이 돼 리뷰가 불가능했다.
# 결론과 표는 메모리·리포트에 남기고, 원자료는 도구로 다시 만든다.
reports/turn/*
# 요약 표만 통과시킨다 — 보고서가 인용할 곳이 필요하다(2026-09-12).
!reports/turn/README.md
!reports/turn/realtime_turn_end.md
# 벤치 탐침의 --sink 중간 산출물. 같은 실행의 *.json 이 메타데이터까지 담은
# 상위집합이라(2026-09-09 확인: 행 수·내용 동일) 둘 다 넣으면 근거가 두 벌이 된다.
# ⚠️ reports/jetson/*.jsonl 은 다르다 — 봇 런타임 계측이고 대응하는 json 이 없다.
reports/bench/*.jsonl

# AI-Hub 원천 오디오 인덱스. 파일이름 -> **이 기계의 절대 경로** 대응표라
# 다른 기계에서 무용하고(15078eb 와 같은 병), 104MB 로 저장소(1.1MB)의 94배다.
# 원본 데이터가 있으면 언제든 다시 만든다. 채점 결과(detail_*.json)만 근거로 남긴다.
reports/stt/young/audio_index.json

# markdown 에서 만들어 내는 제출용 문서. 원본은 docs/final/*.md 다.
# 다시 만들 때마다 바이트가 통째로 바뀌어 이력만 부풀리므로 넣지 않는다.
#   python tools/build_docs_docx.py && powershell tools/update_docx_fields.ps1
docs/final/docx/
